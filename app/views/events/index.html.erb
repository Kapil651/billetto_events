<% content_for :title, "Events" %>

<main class="events-page">
  <header class="events-page__header">
    <p class="events-page__eyebrow">Billetto</p>
    <h1 class="events-page__title">Upcoming Events</h1>
    <p class="events-page__subtitle">Browse imported events with dates, images, and descriptions.</p>
  </header>

  <% if @events.any? %>
    <section class="events-grid" aria-label="Event listings">
      <% @events.each do |event| %>
        <article class="event-card">
          <div class="event-card__media">
            <% if event.image_url.present? %>
              <%= image_tag event.image_url, alt: event.title, class: "event-card__image", loading: "lazy" %>
            <% else %>
              <div class="event-card__placeholder" aria-hidden="true">
                <span>No image</span>
              </div>
            <% end %>
          </div>

          <div class="event-card__body">
            <div class="event-card__meta">
              <time datetime="<%= event.starts_at&.iso8601 %>"><%= event.formatted_date %></time>
              <% if event.state.present? %>
                <span class="event-card__badge event-card__badge--<%= event.state %>"><%= event.state.humanize %></span>
              <% end %>
            </div>

            <h2 class="event-card__title"><%= event.title %></h2>
            <p class="event-card__description"><%= event.brief_description %></p>

            <div class="event-card__votes" aria-label="Event votes">
              <div class="event-card__vote-counts">
                <span class="event-card__vote-count event-card__vote-count--up" title="Upvotes">
                  ▲ <%= event.upvotes_count %>
                </span>
                <span class="event-card__vote-count event-card__vote-count--down" title="Downvotes">
                  ▼ <%= event.downvotes_count %>
                </span>
                <span class="event-card__vote-score" title="Score">
                  Score: <%= event.score %>
                </span>
              </div>

              <% if clerk.user? %>
                <div class="event-card__vote-actions">
                  <%= button_to "Like",
                        event_vote_path(event),
                        method: :post,
                        params: { vote_type: "up" },
                        class: "event-card__vote-button #{'event-card__vote-button--active' if event.user_vote(clerk.user_id) == EventVote::UPVOTE}",
                        form: { class: "event-card__vote-form" } %>
                  <%= button_to "Dislike",
                        event_vote_path(event),
                        method: :post,
                        params: { vote_type: "down" },
                        class: "event-card__vote-button #{'event-card__vote-button--active' if event.user_vote(clerk.user_id) == EventVote::DOWNVOTE}",
                        form: { class: "event-card__vote-form" } %>
                </div>
              <% else %>
                <p class="event-card__vote-signin">
                  <%= link_to "Sign in", sign_in_path %> to vote on this event.
                </p>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="events-empty">
      <h2>No events yet</h2>
      <p>Import events from Billetto to see them listed here.</p>
    </section>
  <% end %>
</main>
