<% content_for :title, "Sign up" %>

<main class="auth-page">
  <section class="auth-card">
    <h1 class="auth-card__title">Create account</h1>
    <p class="auth-card__subtitle">Sign up to get started with Tacnique Kapil.</p>

    <% if clerk_configured? %>
      <div id="clerk-sign-up"></div>
    <% else %>
      <p class="auth-card__message">Clerk is not configured. Add your API keys to <code>config/application.yml</code>.</p>
    <% end %>

    <p class="auth-card__footer">
      Already have an account? <%= link_to "Sign in", sign_in_path %>
    </p>
  </section>
</main>

<% if clerk_configured? %>
  <script>
    window.addEventListener("load", async function () {
      if (typeof Clerk === "undefined") return;

      await Clerk.load();
      Clerk.mountSignUp(document.getElementById("clerk-sign-up"), {
        signInUrl: "<%= sign_in_path %>",
        afterSignUpUrl: "<%= root_path %>"
      });
    });
  </script>
<% end %>
